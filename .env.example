# MySQL 8.0 数据源。请填写实际地址及已有只读账号，不要提交真实密码。
MYSQL_HOST=CHANGE_ME
MYSQL_PORT=3306
MYSQL_USER=CHANGE_ME
# 密码含特殊字符时使用单引号；不要将填写后的真实配置提交到仓库。
MYSQL_PASSWORD='CHANGE_ME'
MYSQL_LOCATION_DB=bh_location
MYSQL_BUSINESS_DB=bh_business
MYSQL_CONNECT_TIMEOUT=10
MYSQL_READ_TIMEOUT=120

# MySQL DATETIME values in the supplied schema are local wall-clock values.
SOURCE_TIMEZONE=Asia/Shanghai

# Keep the writer and tile reader as separate PostgreSQL roles.
PG_SYNC_DSN="host=127.0.0.1 port=5432 dbname=vessel_gis user=vessel_sync password=CHANGE_ME application_name=vessel_sync"
PG_TILE_DSN="host=127.0.0.1 port=5432 dbname=vessel_gis user=vessel_tile password=CHANGE_ME application_name=vessel_tiles"

# Polling intentionally overlaps the previous watermark; PostgreSQL UPSERT removes duplicates.
SYNC_OVERLAP_SECONDS=600
SYNC_FETCH_SIZE=2000

TILE_DB_POOL_SIZE=10
TILE_CACHE_SECONDS=60
TILE_HOST=127.0.0.1
TILE_PORT=7800
